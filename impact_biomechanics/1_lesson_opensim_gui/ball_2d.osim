<?xml version="1.0" encoding="UTF-8" ?>
<OpenSimDocument Version="40600">
	<Model name="bounce_pass">
		<!--List of components that this component owns and serializes.-->
		<components>
			<PhysicalOffsetFrame name="floor_visual">
				<!--The geometry used to display the axes of this Frame.-->
				<FrameGeometry name="frame_geometry">
					<!--Path to a Component that satisfies the Socket 'frame' of type Frame.-->
					<socket_frame>..</socket_frame>
					<!--Scale factors in X, Y, Z directions respectively.-->
					<scale_factors>0.20000000000000001 0.20000000000000001 0.20000000000000001</scale_factors>
				</FrameGeometry>
				<!--List of geometry attached to this Frame. Note, the geometry are treated as fixed to the frame and they share the transform of the frame when visualized-->
				<attached_geometry>
					<Brick name="floor_visual_geom_1">
						<!--Path to a Component that satisfies the Socket 'frame' of type Frame.-->
						<socket_frame>..</socket_frame>
						<!--Default appearance attributes for this Geometry-->
						<Appearance>
							<!--The color, (red, green, blue), [0, 1], used to display the geometry. -->
							<color>0.59999999999999998 0.59999999999999998 0.59999999999999998</color>
						</Appearance>
						<!--Half lengths in X, Y, Z respectively.-->
						<half_lengths>10 0.025000000000000001 10</half_lengths>
					</Brick>
				</attached_geometry>
				<!--Path to a Component that satisfies the Socket 'parent' of type C (description: The parent frame to this frame.).-->
				<socket_parent>/ground</socket_parent>
				<!--Translational offset (in meters) of this frame's origin from the parent frame's origin, expressed in the parent frame.-->
				<translation>0 0.025000000000000001 0</translation>
				<!--Orientation offset (in radians) of this frame in its parent frame, expressed as a frame-fixed x-y-z rotation sequence.-->
				<orientation>-0 0 -0</orientation>
			</PhysicalOffsetFrame>
		</components>
		<!--The model's ground reference frame.-->
		<Ground name="ground">
			<!--The geometry used to display the axes of this Frame.-->
			<FrameGeometry name="frame_geometry">
				<!--Path to a Component that satisfies the Socket 'frame' of type Frame.-->
				<socket_frame>..</socket_frame>
				<!--Scale factors in X, Y, Z directions respectively.-->
				<scale_factors>0.20000000000000001 0.20000000000000001 0.20000000000000001</scale_factors>
			</FrameGeometry>
		</Ground>
		<!--Acceleration due to gravity, expressed in ground.-->
		<gravity>0 -9.8100000000000005 0</gravity>
		<!--List of bodies that make up this model.-->
		<BodySet name="bodyset">
			<objects>
				<Body name="ball">
					<!--The geometry used to display the axes of this Frame.-->
					<FrameGeometry name="frame_geometry">
						<!--Path to a Component that satisfies the Socket 'frame' of type Frame.-->
						<socket_frame>..</socket_frame>
						<!--Scale factors in X, Y, Z directions respectively.-->
						<scale_factors>0.20000000000000001 0.20000000000000001 0.20000000000000001</scale_factors>
					</FrameGeometry>
					<!--List of geometry attached to this Frame. Note, the geometry are treated as fixed to the frame and they share the transform of the frame when visualized-->
					<attached_geometry>
						<Sphere name="ball_geom_1">
							<!--Path to a Component that satisfies the Socket 'frame' of type Frame.-->
							<socket_frame>..</socket_frame>
							<!--Default appearance attributes for this Geometry-->
							<Appearance>
								<!--The color, (red, green, blue), [0, 1], used to display the geometry. -->
								<color>0.90000000000000002 0.45000000000000001 0.10000000000000001</color>
							</Appearance>
							<!--Radius of sphere, defaults to 1.0-->
							<radius>0.12</radius>
						</Sphere>
					</attached_geometry>
					<!--The mass of the body (kg)-->
					<mass>0.59999999999999998</mass>
					<!--The location (Vec3) of the mass center in the body frame.-->
					<mass_center>0 0 0</mass_center>
					<!--The elements of the inertia tensor (Vec6) as [Ixx Iyy Izz Ixy Ixz Iyz] measured about the mass_center and not the body origin.-->
					<inertia>0.0057599999999999995 0.0057599999999999995 0.0057599999999999995 0 0 0</inertia>
				</Body>
			</objects>
			<groups />
		</BodySet>
		<!--List of joints that connect the bodies.-->
		<JointSet name="jointset">
			<objects>
				<CustomJoint name="bounce_pass">
					<!--Path to a Component that satisfies the Socket 'parent_frame' of type PhysicalFrame (description: The parent frame for the joint.).-->
					<socket_parent_frame>/ground</socket_parent_frame>
					<!--Path to a Component that satisfies the Socket 'child_frame' of type PhysicalFrame (description: The child frame for the joint.).-->
					<socket_child_frame>/bodyset/ball</socket_child_frame>
					<!--List containing the generalized coordinates (q's) that parameterize this joint.-->
					<coordinates>
						<Coordinate name="ball_x">
							<!--The speed value of this coordinate before any value has been set. Rotational coordinate value is in rad/s and Translational in m/s.-->
							<default_speed_value>3</default_speed_value>
							<!--The minimum and maximum values that the coordinate can range between. Rotational coordinate range in radians and Translational in meters.-->
							<range>-20 20</range>
						</Coordinate>
						<Coordinate name="ball_y">
							<!--The value of this coordinate before any value has been set. Rotational coordinate value is in radians and Translational in meters.-->
							<default_value>1.1699999999999999</default_value>
							<!--The speed value of this coordinate before any value has been set. Rotational coordinate value is in rad/s and Translational in m/s.-->
							<default_speed_value>0</default_speed_value>
							<!--The minimum and maximum values that the coordinate can range between. Rotational coordinate range in radians and Translational in meters.-->
							<range>0 3</range>
						</Coordinate>
						<Coordinate name="ball_z">
							<!--The speed value of this coordinate before any value has been set. Rotational coordinate value is in rad/s and Translational in m/s.-->
							<default_speed_value>0</default_speed_value>
							<!--The minimum and maximum values that the coordinate can range between. Rotational coordinate range in radians and Translational in meters.-->
							<range>-20 20</range>
						</Coordinate>
					</coordinates>
					<!--The spatial transform defining how the child body moves with respectto the parent as a function of the generalized coordinates.-->
					<SpatialTransform>
						<!--The first TransformAxis defining a rotation about an axis with to a set of generalized coordinates.-->
						<TransformAxis name="rotation1">
							<!--The names of the generalized coordinates that serve as the independent variables of the transform function.-->
							<coordinates></coordinates>
							<!--The rotation or translation axis for the transform. Default: (1,0,0).-->
							<axis>1 0 0</axis>
						</TransformAxis>
						<!--The second TransformAxis defining a rotation about an axis with to a set of generalized coordinates.-->
						<TransformAxis name="rotation2">
							<!--The names of the generalized coordinates that serve as the independent variables of the transform function.-->
							<coordinates></coordinates>
							<!--The rotation or translation axis for the transform. Default: (1,0,0).-->
							<axis>0 1 0</axis>
						</TransformAxis>
						<!--The third TransformAxis defining a rotation about an axis with to a set of generalized coordinates.-->
						<TransformAxis name="rotation3">
							<!--The names of the generalized coordinates that serve as the independent variables of the transform function.-->
							<coordinates></coordinates>
							<!--The rotation or translation axis for the transform. Default: (1,0,0).-->
							<axis>0 0 1</axis>
						</TransformAxis>
						<!--The first TransformAxis defining a translation along an axis with to a set of generalized coordinates.-->
						<TransformAxis name="translation1">
							<!--The names of the generalized coordinates that serve as the independent variables of the transform function.-->
							<coordinates>ball_x</coordinates>
							<!--The rotation or translation axis for the transform. Default: (1,0,0).-->
							<axis>1 0 0</axis>
							<!--The transform function with respect to the generalized coordinates used to represent the amount of displacement about or along the TransformAxis. Default: Constant(0).-->
							<LinearFunction name="function">
								<coefficients> 1 0</coefficients>
							</LinearFunction>
						</TransformAxis>
						<!--The second TransformAxis defining a translation along an axis with to a set of generalized coordinates.-->
						<TransformAxis name="translation2">
							<!--The names of the generalized coordinates that serve as the independent variables of the transform function.-->
							<coordinates>ball_y</coordinates>
							<!--The rotation or translation axis for the transform. Default: (1,0,0).-->
							<axis>0 1 0</axis>
							<!--The transform function with respect to the generalized coordinates used to represent the amount of displacement about or along the TransformAxis. Default: Constant(0).-->
							<LinearFunction name="function">
								<coefficients> 1 0</coefficients>
							</LinearFunction>
						</TransformAxis>
						<!--The third TransformAxis defining a translation along an axis with to a set of generalized coordinates.-->
						<TransformAxis name="translation3">
							<!--The names of the generalized coordinates that serve as the independent variables of the transform function.-->
							<coordinates>ball_z</coordinates>
							<!--The rotation or translation axis for the transform. Default: (1,0,0).-->
							<axis>0 0 1</axis>
							<!--The transform function with respect to the generalized coordinates used to represent the amount of displacement about or along the TransformAxis. Default: Constant(0).-->
							<LinearFunction name="function">
								<coefficients> 1 0</coefficients>
							</LinearFunction>
						</TransformAxis>
					</SpatialTransform>
				</CustomJoint>
			</objects>
			<groups />
		</JointSet>
		<!--Controllers that provide the control inputs for Actuators.-->
		<ControllerSet name="controllerset">
			<objects />
			<groups />
		</ControllerSet>
		<!--Forces in the model (includes Actuators).-->
		<ForceSet name="forceset">
			<objects>
				<HuntCrossleyForce name="contact">
					<!--Material properties.-->
					<HuntCrossleyForce::ContactParametersSet name="contact_parameters">
						<objects>
							<HuntCrossleyForce::ContactParameters>
								<!--Names of geometry objects affected by these parameters.-->
								<geometry>ball_contact floor</geometry>
								<stiffness>10000000</stiffness>
								<dissipation>0.050000000000000003</dissipation>
								<static_friction>0.20000000000000001</static_friction>
								<dynamic_friction>0.14999999999999999</dynamic_friction>
								<viscous_friction>0</viscous_friction>
							</HuntCrossleyForce::ContactParameters>
						</objects>
						<groups />
					</HuntCrossleyForce::ContactParametersSet>
				</HuntCrossleyForce>
			</objects>
			<groups />
		</ForceSet>
		<!--Geometry to be used in contact forces.-->
		<ContactGeometrySet name="contactgeometryset">
			<objects>
				<ContactHalfSpace name="floor">
					<!--Path to a Component that satisfies the Socket 'frame' of type PhysicalFrame (description: The frame to which this contact geometry is attached.).-->
					<socket_frame>/ground</socket_frame>
					<!--The location of the contact geometry center in the PhysicalFrame.-->
					<location>0 0.050000000000000003 0</location>
					<!--The orientation of the contact geometry in the PhysicalFrame in body-fixed XYZ Euler angles.-->
					<orientation>0 0 -1.5707963267948966</orientation>
				</ContactHalfSpace>
				<ContactSphere name="ball_contact">
					<!--Path to a Component that satisfies the Socket 'frame' of type PhysicalFrame (description: The frame to which this contact geometry is attached.).-->
					<socket_frame>/bodyset/ball</socket_frame>
					<!--The location of the contact geometry center in the PhysicalFrame.-->
					<location>0 0 0</location>
					<!--The orientation of the contact geometry in the PhysicalFrame in body-fixed XYZ Euler angles.-->
					<orientation>0 0 0</orientation>
					<!--The radius of the sphere (default: 0).-->
					<radius>0.12</radius>
				</ContactSphere>
			</objects>
			<groups />
		</ContactGeometrySet>
	</Model>
</OpenSimDocument>
